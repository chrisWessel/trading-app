# ============================================================================
# WesSignal Local MT5 Bridge Configuration (.env.example)
# Copy this file to .env and customize as needed.
# ============================================================================

# Mandatory Zero-Trust Webhook Secret Token (must match Vercel's MT5_BRIDGE_SECRET_TOKEN)
MT5_BRIDGE_SECRET_TOKEN=wessignal_mt5_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a

# Bridge Server Bindings (Port 8001 avoids colliding with main backend on Port 8000)
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8001

# Default Trading & Volumetric Fallback Parameters
DEFAULT_LOT_SIZE=0.01
MAX_LOT_SIZE=5.00
MAX_SLIPPAGE_POINTS=20
MAGIC_NUMBER=202605
ORDER_COMMENT_PREFIX=WesSignal

# Optional Explicit MT5 Terminal Credentials
# Leave blank to attach automatically to the currently open & logged-in Windows MT5 terminal.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional Permanent Cloudflare Tunnel Token (leave blank when using Quick Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

